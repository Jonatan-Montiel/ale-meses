<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="@drawable/widget_bg">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/dA" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:background="@drawable/dot_ella"
        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="A"/>
    <TextView android:id="@+id/dLine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
        android:maxLines="1" android:textColor="#F7C6D3" android:textSize="14sp" android:text="~~~ 💗 ~~~"/>
    <TextView android:id="@+id/dJ" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:background="@drawable/dot_yo"
        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:text="J"/>
  </LinearLayout>
  <TextView android:id="@+id/dTxt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
      android:maxLines="2" android:gravity="center" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:text="📍"/>
</LinearLayout>
